<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <% if (String(htmlWebpackPlugin.options.root).startsWith('/templates/')) { %>
      <script>
        // Aniratch（わんコメのテンプレート版）: ファイルとして直接開かれたら、わんコメが配信している URL へ移る
        (function () {
          var page = location.pathname.split('/').pop() || 'index.html';
          // トップ（index.html）はエディタで開く
          var openEditor = page === 'index.html' && !location.hash;
          if (openEditor) page = 'editor.html';
          if (location.protocol === 'file:') {
            location.replace('http://localhost:11180<%= htmlWebpackPlugin.options.root %>' + page + location.search + location.hash);
          } else if (openEditor) {
            location.replace('<%= htmlWebpackPlugin.options.root %>' + page + location.search);
          }
        })();
      </script>
    <% } %>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="google" value="notranslate">
    <title><%= htmlWebpackPlugin.options.title %></title>
    <style>
      .splash-screen {
        position: absolute;
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
        background-color: #0D0D0D;
        color: #F0F0F0;
        gap: 12px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
      }
      .splash-screen[hidden] {
        display: none;
      }
      /* Aniratch: 公式サイト風のロード表示を、小さい埋め込み枠に収まる大きさで */
      .ani-text {
        font-family: 'Oswald', 'Bahnschrift', 'Arial Narrow', sans-serif;
        font-size: 1.1rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        color: #fff;
      }
      .ani-text::before { content: '>'; margin-right: 0.35em; font-family: 'M PLUS 1 Code', Consolas, monospace; color: #66CCFF; }
      .ani-text::after {
        content: '';
        display: inline-block;
        width: 0.5em;
        height: 0.85em;
        margin-left: 0.25em;
        vertical-align: -0.04em;
        background: #FFF600;
        animation: ani-cursor 1.1s steps(2, jump-none) infinite;
      }
      .ani-bar {
        position: relative;
        width: min(240px, 70%);
        height: 10px;
        padding: 2px;
        border: 2px solid #FFF600;
      }
      .ani-bar i {
        position: absolute;
        top: 2px;
        left: 2px;
        width: 10px;
        height: 10px;
        background: #FFF600;
        animation: ani-slide 1.4s ease-in-out infinite alternate;
      }
      @keyframes ani-cursor { from { opacity: 1; } to { opacity: 0; } }
      @keyframes ani-slide { from { left: 2px; } to { left: calc(100% - 12px); } }
      @media (prefers-reduced-motion: reduce) {
        .ani-text::after, .ani-bar i { animation: none; }
      }
    </style>
  </head>
  <body>
    <noscript>
      <div class="splash-screen">
        <h1>This embed requires JavaScript</h1>
      </div>
    </noscript>

    <div class="splash-screen" hidden id="splash-need-js">
      <div class="ani-text">LOADING</div>
      <div class="ani-bar" aria-hidden="true"><i></i></div>
    </div>

    <script>
      (function() {
        'use strict';

        var splash = document.getElementById('splash-need-js');
        splash.hidden = false;

        window.SplashEnd = () => {
          splash.hidden = true;
        };
      }());
    </script>

    <div id="app"></div>
  </body>
</html>
